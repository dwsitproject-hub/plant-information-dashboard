# /opt/pid/.env on each production server - read by Docker Compose itself (not by the app).
# Copy, then set PID_SUBNET to the line "suggested subnet for pid_net" printed by
# preflight.sh on THAT server (the two servers may get different values).
PID_SUBNET=FILL_FROM_PREFLIGHT

# Only if the preflight reported a port taken (use the free one it printed, and the same number
# everywhere the guide's §1 lists):
# PID_API_BIND=172.28.80.51:3011        # BE server
# PID_WEB_BIND=172.28.80.50:3091        # FE server
# PID_BACKEND_URL=http://172.28.80.51:3011
