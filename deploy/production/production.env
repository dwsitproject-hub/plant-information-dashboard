# /opt/pid/production.env on the BE server 172.28.80.51 - the API's settings (no secrets here;
# those go in secrets.production.env). Copy from the checkout, then edit the FILL_ lines with nano.
# release.sh refuses to run while a FILL_ value is left.

APP_ENV=production

# The address users open: http://pid.kpndomain.com, through the FE host nginx (guide §11).
# The private address http://172.28.80.50:3091 keeps answering for checks and local sign-in; Hub sign-in
# works only on the domain, because the Hub returns to OIDC_REDIRECT_URI below.
APP_PUBLIC_ORIGIN=http://pid.kpndomain.com
CORS_ORIGIN=http://pid.kpndomain.com,http://172.28.80.50:3091
# false while the app is served over plain HTTP; true once it is HTTPS (guide §11).
COOKIE_SECURE=false
JWT_EXPIRES_IN=8h

# The API is called only by the web container on the FE server; take the visitor's address from
# that hop alone (the per-address sign-in limit depends on it).
TRUST_PROXY=172.28.80.50

# Sign-in through the production DWS Hub (OpenID Connect). The legacy HS256 bridge stays off.
SSO_OIDC_ENABLED=true
SSO_LEGACY_BRIDGE_ENABLED=false
# The Hub's discovery document says this issuer (preflight be, 17 Nov 2026); byte for byte.
OIDC_ISSUER=https://dwshub.kpndomain.com
OIDC_DISCOVERY_URL=https://dwshub.kpndomain.com/api/sso/.well-known/openid-configuration
# The production Hub registration (guide §4): OIDC (strict), this redirect URI, byte for byte.
OIDC_CLIENT_ID=plant-information-dashboard
OIDC_REDIRECT_URI=http://pid.kpndomain.com/auth/oidc/callback
OIDC_SCOPES=openid profile email

# Database limits (defaults shown).
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000

# Per-address limits (defaults shown). Raise if a whole site office shares one address.
LOGIN_RATE_LIMIT_PER_MINUTE=30
API_RATE_LIMIT_PER_MINUTE=600

# Gauge poller (defaults shown; the round times are set per site on the Tank gauging page).
TANK_GAUGING_TIMEOUT_MS=15000
TANK_GAUGING_SAMPLE_ACTIVE_DAYS=30
TANK_GAUGING_SAMPLE_ARCHIVE_DAYS=7
