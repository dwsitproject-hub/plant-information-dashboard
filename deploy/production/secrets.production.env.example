# /opt/pid/secrets.production.env on the BE server 172.28.80.51 - chmod 600, filled with nano, never
# committed, never pasted into chat. Keep a copy of each value in the password vault.

# The production database (guide §3). Percent-encode the password if it has # @ : / ? or %.
DATABASE_URL=postgresql://FILL_DB_USER:FILL_DB_PASSWORD@FILL_RDS_HOST:5432/FILL_DB_NAME

# Signs the session cookie. 64 random hex characters (guide §7: openssl rand -hex 32).
# Never the staging value. Changing it later signs everyone out.
JWT_SECRET=FILL_RANDOM_64_HEX

# Encrypts stored credentials (the DataHub private key, gauge passwords). Its own value, not
# JWT_SECRET (architecture review AR-17). Changing it later makes stored credentials unreadable:
# re-enter them in the admin pages.
DATAHUB_SECRET_KEY=FILL_RANDOM_64_HEX
